# Copy to .env and load into your n8n process environment (never commit a real .env).
# The LLM nodes read these via n8n expressions, with the local Ollama values as fallback.

# OpenAI-compatible chat endpoint. Default is local Ollama.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
# Only needed for a hosted provider; Ollama ignores it. Add it as an
# "Authorization: Bearer ${LLM_API_KEY}" header on the HTTP Request node.
LLM_API_KEY=ollama

# Feed used by workflow 3 (rss-to-social). Any RSS/Atom URL.
RSS_FEED_URL=https://hnrss.org/frontpage
